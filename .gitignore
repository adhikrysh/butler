# Secrets — never commit
.env
*.env
**/secrets/

# Hermes profile state (lives under ~/.hermes, not here) — guard against accidental copies
state.db
*.sqlite

# Per-module runtime state (e.g. served-letter history)
**/state/
**/*.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# OS / editor
.DS_Store
*.swp

# Local scratch / inspection dumps (never committed)
scrap/

# Design docs & plans — kept locally, not tracked in this repo
docs/

# Local Claude instructions (copy of personal global rules) — never public
/CLAUDE.md

# Local ops runbook (box internals + sandbox wiring) — never public
/OPERATIONS.md
